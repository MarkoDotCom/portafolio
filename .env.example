# Copia este archivo a .env y ajusta los valores. .env NO se versiona.

# --- Base de datos (docker compose: servicio db) ---
POSTGRES_USER=portafolio
POSTGRES_PASSWORD=portafolio
POSTGRES_DB=portafolio
POSTGRES_PORT=5432

# --- Cliente Angular (docker compose: servicio client) ---
CLIENT_PORT=4200

# --- Usuario con el que corren api y client en docker (por defecto 1000:1000; ver `id -u` / `id -g`) ---
# HOST_UID=1000
# HOST_GID=1000

# --- API keys de proveedores externos ---
# Agrega aquí una variable por proveedor, p. ej.:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- API NestJS (docker compose: servicio api) ---
API_PORT=3000
# Conexión desde el host. Dentro del compose se sobreescribe apuntando a db:5432.
DATABASE_URL=postgresql://portafolio:portafolio@localhost:5432/portafolio
