generator client {
  provider        = "prisma-client"
  output          = "../generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model app_user {
  id                                                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                             String                  @unique @db.Citext
  external_auth_id                                  String?                 @unique
  full_name                                         String
  avatar_media_id                                   String?                 @db.Uuid
  created_at                                        DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                                        DateTime                @default(now()) @db.Timestamptz(6)
  media_asset_app_user_avatar_media_idTomedia_asset media_asset?            @relation("app_user_avatar_media_idTomedia_asset", fields: [avatar_media_id], references: [id], onUpdate: NoAction, map: "app_user_avatar_fk")
  company                                           company[]
  company_member                                    company_member[]
  job_application_event                             job_application_event[]
  job_posting                                       job_posting[]
  media_asset_media_asset_owner_idToapp_user        media_asset[]           @relation("media_asset_owner_idToapp_user")
  worker_profile                                    worker_profile?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model certification {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  worker_id      String         @db.Uuid
  name           String
  issuer         String
  issued_at      DateTime       @db.Date
  expires_at     DateTime?      @db.Date
  credential_id  String?
  credential_url String?
  is_visible     Boolean        @default(true)
  sort_order     Int            @default(0)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @default(now()) @db.Timestamptz(6)
  worker_profile worker_profile @relation(fields: [worker_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([worker_id, sort_order], map: "certification_worker_idx")
}

model company {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String           @unique @db.Citext
  name           String
  description    String?
  website_url    String?
  industry       String?
  size           company_size?
  location       String?
  logo_media_id  String?          @db.Uuid
  created_by     String?          @db.Uuid
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  app_user       app_user?        @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  media_asset    media_asset?     @relation(fields: [logo_media_id], references: [id], onUpdate: NoAction)
  company_member company_member[]
  experience     experience[]
  job_posting    job_posting[]
}

model company_member {
  company_id String       @db.Uuid
  user_id    String       @db.Uuid
  role       company_role @default(recruiter)
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  company    company      @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_user   app_user     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([company_id, user_id])
  @@index([user_id], map: "company_member_user_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model education {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  worker_id      String         @db.Uuid
  institution    String
  degree         String
  field_of_study String?
  start_date     DateTime       @db.Date
  end_date       DateTime?      @db.Date
  description    String?
  is_visible     Boolean        @default(true)
  sort_order     Int            @default(0)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @default(now()) @db.Timestamptz(6)
  worker_profile worker_profile @relation(fields: [worker_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([worker_id, sort_order], map: "education_worker_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model experience {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  worker_id        String             @db.Uuid
  company_id       String?            @db.Uuid
  company_name     String
  title            String
  employment_type  employment_type?
  work_mode        work_mode?
  location         String?
  start_date       DateTime           @db.Date
  end_date         DateTime?          @db.Date
  description      String?
  is_visible       Boolean            @default(true)
  sort_order       Int                @default(0)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  company          company?           @relation(fields: [company_id], references: [id], onUpdate: NoAction)
  worker_profile   worker_profile     @relation(fields: [worker_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  experience_skill experience_skill[]

  @@index([company_id], map: "experience_company_idx", where: raw("(company_id IS NOT NULL)"))
  @@index([worker_id, sort_order], map: "experience_worker_idx")
}

model experience_skill {
  experience_id String     @db.Uuid
  skill_id      String     @db.Uuid
  experience    experience @relation(fields: [experience_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  skill         skill      @relation(fields: [skill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([experience_id, skill_id])
  @@index([skill_id], map: "experience_skill_skill_idx")
}

model job_application {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_posting_id        String                  @db.Uuid
  worker_id             String                  @db.Uuid
  status                application_status      @default(applied)
  cover_letter          String?
  applied_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  job_posting           job_posting             @relation(fields: [job_posting_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  worker_profile        worker_profile          @relation(fields: [worker_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  job_application_event job_application_event[]

  @@unique([job_posting_id, worker_id], map: "job_application_uq")
  @@index([job_posting_id, status], map: "job_application_posting_idx")
  @@index([worker_id, applied_at(sort: Desc)], map: "job_application_worker_idx")
}

model job_application_event {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id  String              @db.Uuid
  changed_by      String?             @db.Uuid
  from_status     application_status?
  to_status       application_status
  note            String?
  created_at      DateTime            @default(now()) @db.Timestamptz(6)
  job_application job_application     @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_user        app_user?           @relation(fields: [changed_by], references: [id], onUpdate: NoAction)

  @@index([application_id, created_at], map: "job_application_event_app_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model job_posting {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id        String              @db.Uuid
  created_by        String?             @db.Uuid
  title             String
  description       String
  employment_type   employment_type
  work_mode         work_mode
  location          String?
  salary_min        Decimal?            @db.Decimal(12, 2)
  salary_max        Decimal?            @db.Decimal(12, 2)
  salary_currency   String?             @db.Char(3)
  status            job_status          @default(draft)
  published_at      DateTime?           @db.Timestamptz(6)
  closes_at         DateTime?           @db.Timestamptz(6)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  job_application   job_application[]
  company           company             @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_user          app_user?           @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  job_posting_skill job_posting_skill[]

  @@index([company_id, status], map: "job_posting_company_idx")
  @@index([published_at(sort: Desc)], map: "job_posting_published_idx", where: raw("(status = 'published'::job_status)"))
}

model job_posting_skill {
  job_posting_id String      @db.Uuid
  skill_id       String      @db.Uuid
  is_required    Boolean     @default(true)
  job_posting    job_posting @relation(fields: [job_posting_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  skill          skill       @relation(fields: [skill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([job_posting_id, skill_id])
  @@index([skill_id], map: "job_posting_skill_skill_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model media_asset {
  id                                             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id                                       String          @db.Uuid
  storage_key                                    String          @unique
  url                                            String
  mime_type                                      String
  size_bytes                                     BigInt
  alt_text                                       String?
  created_at                                     DateTime        @default(now()) @db.Timestamptz(6)
  app_user_app_user_avatar_media_idTomedia_asset app_user[]      @relation("app_user_avatar_media_idTomedia_asset")
  company                                        company[]
  app_user_media_asset_owner_idToapp_user        app_user        @relation("media_asset_owner_idToapp_user", fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  project                                        project[]
  project_media                                  project_media[]

  @@index([owner_id], map: "media_asset_owner_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model project {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  worker_id      String          @db.Uuid
  slug           String          @db.Citext
  title          String
  summary        String?
  description    String?
  repo_url       String?
  demo_url       String?
  cover_media_id String?         @db.Uuid
  started_at     DateTime?       @db.Date
  ended_at       DateTime?       @db.Date
  is_featured    Boolean         @default(false)
  is_visible     Boolean         @default(true)
  sort_order     Int             @default(0)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6)
  media_asset    media_asset?    @relation(fields: [cover_media_id], references: [id], onUpdate: NoAction)
  worker_profile worker_profile  @relation(fields: [worker_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  project_media  project_media[]
  project_skill  project_skill[]

  @@unique([worker_id, slug], map: "project_slug_uq")
  @@index([worker_id, sort_order], map: "project_worker_idx")
}

model project_media {
  project_id  String      @db.Uuid
  media_id    String      @db.Uuid
  sort_order  Int         @default(0)
  media_asset media_asset @relation(fields: [media_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  project     project     @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([project_id, media_id])
}

model project_skill {
  project_id String  @db.Uuid
  skill_id   String  @db.Uuid
  project    project @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  skill      skill   @relation(fields: [skill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([project_id, skill_id])
  @@index([skill_id], map: "project_skill_skill_idx")
}

model skill {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String              @unique @db.Citext
  category          skill_category      @default(other)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  experience_skill  experience_skill[]
  job_posting_skill job_posting_skill[]
  project_skill     project_skill[]
  worker_skill      worker_skill[]
}

model social_link {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  worker_id      String          @db.Uuid
  platform       social_platform
  url            String
  sort_order     Int             @default(0)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  worker_profile worker_profile  @relation(fields: [worker_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([worker_id, sort_order], map: "social_link_worker_idx")
}

model worker_profile {
  user_id         String            @id @db.Uuid
  slug            String            @unique @db.Citext
  headline        String?
  summary         String?
  location        String?
  is_public       Boolean           @default(false)
  open_to_work    Boolean           @default(false)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  certification   certification[]
  education       education[]
  experience      experience[]
  job_application job_application[]
  project         project[]
  social_link     social_link[]
  app_user        app_user          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  worker_skill    worker_skill[]

  @@index([open_to_work], map: "worker_profile_open_idx", where: raw("is_public"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model worker_skill {
  worker_id      String         @db.Uuid
  skill_id       String         @db.Uuid
  level          Int?           @db.SmallInt
  sort_order     Int            @default(0)
  skill          skill          @relation(fields: [skill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  worker_profile worker_profile @relation(fields: [worker_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([worker_id, skill_id])
  @@index([skill_id], map: "worker_skill_skill_idx")
}

enum application_status {
  applied
  reviewing
  interview
  offer
  rejected
  withdrawn
}

enum company_role {
  owner
  recruiter
}

enum company_size {
  s1_10      @map("1-10")
  s11_50     @map("11-50")
  s51_200    @map("51-200")
  s201_500   @map("201-500")
  s501_1000  @map("501-1000")
  s1001_plus @map("1001+")
}

enum employment_type {
  full_time
  part_time
  contract
  internship
  freelance
}

enum job_status {
  draft
  published
  closed
}

enum skill_category {
  language
  framework
  tool
  database
  cloud
  soft_skill
  other
}

enum social_platform {
  github
  linkedin
  website
  twitter
  other
}

enum work_mode {
  onsite
  hybrid
  remote
}
